# SelfX configuration — copy to .env and adjust. All vars are read by server/app/config.py
# (api + worker) unless marked compose-only.

# --- core ---
SELFX_SECRET_KEY=change-me-long-random          # JWT signing key (HS256). REQUIRED — generate e.g. `openssl rand -hex 32`
SELFX_ADMIN_USER=admin                          # bootstrap admin username (created only if users table is empty)
SELFX_ADMIN_PASSWORD=change-me                  # bootstrap admin password — change before first start
DATABASE_URL=postgresql+psycopg://selfx:selfx@db:5432/selfx  # SQLAlchemy DSN; keep credentials in sync with POSTGRES_* below
REDIS_URL=redis://redis:6379/0                  # Redis connection for the RQ queues
DATA_DIR=/data                                  # uploads/ and outputs/ live under this (volume mount in containers)

# --- limits & retention ---
MAX_UPLOAD_MB=512                               # reject uploads larger than this (streamed check, 413)
FILE_RETENTION_HOURS=24                         # delete uploads/outputs after N hours; 0 = keep forever
JOB_TIMEOUT_SECONDS=1800                        # per-job hard timeout enforced by RQ
RATE_LIMIT_PER_MINUTE=60                        # per-user rate limit on job creation & upload endpoints

# --- integrations ---
GOTENBERG_URL=http://gotenberg:3000             # Gotenberg document-conversion API
OLLAMA_URL=http://ollama:11434                  # Ollama API (only used when the `ai` profile is running)
OLLAMA_MODEL=qwen3:8b                           # default LLM for ai-summarize / doc-qa
OLLAMA_KEEP_ALIVE=30s                            # how long Ollama keeps a model in (V)RAM after use; "0"=unload now, "5m"=stay warm
WHISPER_MODEL=small                             # faster-whisper model size (tiny/base/small/medium/large-v3)
WHISPER_DEVICE=cpu                              # cpu | cuda (docker-compose.gpu.yml sets cuda)
WHISPER_COMPUTE=int8                            # int8 (cpu) | float16 (gpu)
CLAMAV_ENABLED=false                            # scan uploads with ClamAV (start the `security` profile too)
CLAMAV_HOST=clamav                              # clamd hostname
CLAMAV_PORT=3310                                # clamd TCP port

# --- postgres container ---
POSTGRES_USER=selfx                             # postgres superuser created by the db container
POSTGRES_PASSWORD=selfx                         # change on any exposed host, and mirror it in DATABASE_URL
POSTGRES_DB=selfx                               # database name

# --- compose-only ---
WORKER_MEM_LIMIT=6g                             # hard memory cap for the worker container
SELFX_DOMAIN=localhost                          # public domain for the Caddy TLS proxy (`proxy` profile)
