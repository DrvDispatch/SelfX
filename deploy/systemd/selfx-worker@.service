[Unit]
Description=SelfX %i job worker
Wants=network-online.target
Requires=postgresql.service selfx-redis.service
After=network-online.target postgresql.service selfx-redis.service

[Service]
User=selfx
Group=selfx
WorkingDirectory=/opt/selfx/current/server
EnvironmentFile=/etc/selfx/selfx.env
Environment=HOME=/var/lib/selfx PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
Environment=PATH=/opt/selfx/current/venv/bin:/usr/bin:/bin
ExecStart=/opt/selfx/current/venv/bin/python -m app.worker %i
Restart=on-failure
RestartSec=5s
# Send SIGTERM to RQ first so it can finish the current job before shutdown.
KillMode=mixed
TimeoutStopSec=120s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/selfx

[Install]
WantedBy=multi-user.target
